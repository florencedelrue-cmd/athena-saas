# ============================================================
# ATHENA TOCI 2.0 — Environment Variables
# ============================================================
# Lokaal:  kopieer naar .env.local
# Vercel:  Project → Settings → Environment Variables
#           (Production + Preview + Development voor Supabase keys)
# ============================================================

# ── BEHEERDER PREVIEW (zonder login, alleen jij) ─────────────
# Kies een lang, uniek wachtwoord. Alleen server-side — nooit in client code!
# ADMIN_PREVIEW_SECRET=jouw-geheime-sleutel-hier
# Open eenmalig: https://athena-saas.vercel.app/api/admin/enter-preview?key=jouw-geheime-sleutel-hier
# Afsluiten: https://athena-saas.vercel.app/api/admin/exit-preview

# ── PREVIEW MODE (optioneel — voor iedereen, niet aanbevolen op production) ──
# Standaard: cloud-sync via Supabase als URL + anon key gezet zijn.
# Alleen lokaal in deze browser (geen login, geen sync):
# NEXT_PUBLIC_PREVIEW_MODE=true

# ── SUPABASE (verplicht voor live sync tussen leerkrachten) ──
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alleen server-side (signup). NOOIT in client code!
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── APP URL (verplicht op Vercel Production) ───────────────
# Lokaal:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel Production (pas aan na eerste deploy):
# NEXT_PUBLIC_APP_URL=https://jouw-project.vercel.app

# ── STRIPE (optioneel — billing prep) ───────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── MICROSOFT LOGIN (Optie A — via Supabase Azure provider) ──
# ICT eenmalig configureren:
# 1. Supabase Dashboard → Authentication → Providers → Azure → Enable
# 2. Azure Portal → App registrations → New → Redirect URI:
#    https://[project-ref].supabase.co/auth/v1/callback
# 3. Supabase → Authentication → URL Configuration → Redirect URLs:
#    https://athena-saas.vercel.app/auth/callback
#    http://localhost:3000/auth/callback
# 4. Vul Azure Client ID + Secret in bij Supabase Azure provider
# 5. Zet SUPABASE_SERVICE_ROLE_KEY ook op Production (Vercel)

# ── BEHEERDER PREVIEW (zonder login, alleen jij) ─────────────
# Kies een lang, uniek wachtwoord. Alleen server-side!
# ADMIN_PREVIEW_SECRET=jouw-geheime-sleutel
# Open eenmalig: /api/admin/enter-preview?key=jouw-geheime-sleutel
# Afsluiten: /api/admin/exit-preview
# 1. Run supabase/COMPLETE_SETUP.sql + migrations/005_enable_realtime.sql in Supabase
# 2. Zet bovenstaande vars in Vercel (alle Production scopes)
# 3. git push → Vercel deployt automatisch
# 4. Registreer account op /signup → demo-data wordt aangemaakt
# 5. Controleer env: node scripts/check-env.mjs
# ============================================================
